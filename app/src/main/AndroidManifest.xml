<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools">

    <!-- Network at Internet Permissions para sa Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartGrow"
        tools:targetApi="31">

        <!-- 🚀 1. Splash / Launcher Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🏁 2. Onboarding / Authentication Entry -->
        <activity
            android:name=".GetStartedActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- 📝 3. Registration Flow Steps -->
        <activity
            android:name=".RegisterStep1Activity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".RegisterStep2Activity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".RegisterStep3Activity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".RegisterStep4Activity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".RegisterStep5Activity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- 🔐 4. Password Recovery / OTP -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".VerifyOTPActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".ResetPasswordActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- 🏠 5. Main Screen / Dashboard -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Preloaded Fonts Configuration -->
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>