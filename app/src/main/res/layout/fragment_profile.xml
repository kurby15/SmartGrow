<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_profile_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tv_profile_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Manage your account settings"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/tv_profile_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_profile_subtitle">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_profile_pic"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_user"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/btn_camera_badge"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_camera_circle"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintBottom_toBottomOf="@id/iv_profile_pic"
                        app:layout_constraintEnd_toEndOf="@id/iv_profile_pic" />

                    <TextView
                        android:id="@+id/tv_user_display_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:fontFamily="@font/poppins"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_profile_pic" />

                    <LinearLayout
                        android:id="@+id/layout_rank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/indicator_green"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_user_display_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_leaf_right"
                            app:tint="#FFFFFF"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:id="@+id/tv_user_rank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Master Planter"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <View
                        android:id="@+id/header_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/layout_rank"/>

                    <LinearLayout
                        android:id="@+id/layout_stats_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="3"
                        app:layout_constraintTop_toBottomOf="@id/header_divider">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_plant"
                                app:tint="#2E7D32"/>
                            <TextView
                                android:id="@+id/tv_stats_plants"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Plants"
                                android:textStyle="bold"
                                android:textColor="#2E7D32"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_scan"
                                app:tint="#F57F17"/>
                            <TextView
                                android:id="@+id/tv_stats_scans"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Scans"
                                android:textStyle="bold"
                                android:textColor="#F57F17"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_post"
                                app:tint="#1565C0"/>
                            <TextView
                                android:id="@+id/tv_stats_posts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Posts"
                                android:textStyle="bold"
                                android:textColor="#1565C0"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/poppins"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/card_profile_info">

                <!-- 🌿 PREMIUM INTERESTS CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_my_interests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_leaf_right"
                                app:tint="@color/primary_green" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="My Plant Interests"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:fontFamily="@font/poppins"
                                android:textSize="15sp"/>
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_interests"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="6dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/tv_choice2"
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:textColor="#2E7D32"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#E8F5E9"
                                app:chipIcon="@drawable/ic_leaf_right"
                                app:chipIconTint="#2E7D32"
                                app:chipStrokeWidth="0dp"
                                app:chipCornerRadius="12dp"
                                tools:text="Herbal" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/tv_choice3"
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:textColor="#E65100"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#FFF3E0"
                                app:chipIcon="@drawable/ic_health_sun"
                                app:chipIconTint="#EF6C00"
                                app:chipStrokeWidth="0dp"
                                app:chipCornerRadius="12dp"
                                tools:text="Outdoor" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/tv_choice4"
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins"
                                android:textColor="#1565C0"
                                android:textSize="13sp"
                                app:chipBackgroundColor="#E3F2FD"
                                app:chipIcon="@drawable/ic_water_drop"
                                app:chipIconTint="#1565C0"
                                app:chipStrokeWidth="0dp"
                                app:chipCornerRadius="12dp"
                                tools:text="Daily Care" />

                        </com.google.android.material.chip.ChipGroup>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="* Personalized care tips are based on these interests."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins"
                            android:fontStyle="italic"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Settings Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_preferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="App Preferences"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/card_background"
                    app:cornerRadius="16dp"
                    android:drawableEnd="@drawable/ic_next"
                    app:icon="@drawable/ic_edit_pencil"
                    app:iconTint="@color/text_secondary"
                    app:iconPadding="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_security"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Account &amp; Security"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/card_background"
                    app:cornerRadius="16dp"
                    android:drawableEnd="@drawable/ic_next"
                    app:icon="@drawable/ic_camera_circle"
                    app:iconTint="@color/text_secondary"
                    app:iconPadding="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_support"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Help &amp; Support"
                    android:textColor="@color/text_primary"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/card_background"
                    app:cornerRadius="16dp"
                    android:drawableEnd="@drawable/ic_next"
                    app:icon="@drawable/ic_comment"
                    app:iconTint="@color/text_secondary"
                    app:iconPadding="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textColor="#FF3333"
                    android:fontFamily="@font/poppins"
                    android:backgroundTint="@color/card_background"
                    android:gravity="start|center_vertical"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="#FF3333"
                    app:iconPadding="12dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>