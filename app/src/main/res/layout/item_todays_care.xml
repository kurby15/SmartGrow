<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp"
    android:paddingHorizontal="8dp">

    <!-- CardView para sa Rounded Corners ng Image -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_plant_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iv_plant_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_9" />

    </androidx.cardview.widget.CardView>

    <!-- Plant Name -->
    <TextView
        android:id="@+id/tv_plant_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="3dp"
        android:text="Monstera Deliciosa"
        android:textSize="10sp"
        android:fontFamily="@font/inter_extrabold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/card_plant_image"
        app:layout_constraintStart_toEndOf="@id/card_plant_image"
        app:layout_constraintEnd_toStartOf="@id/btn_action" />

    <!-- Due Date / Status -->
    <TextView
        android:id="@+id/tv_plant_due"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:text="💧 Due is 2 hours"
        android:textSize="8sp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/primary_green"
        app:layout_constraintTop_toBottomOf="@id/tv_plant_name"
        app:layout_constraintStart_toEndOf="@id/card_plant_image"
        app:layout_constraintEnd_toStartOf="@id/btn_action" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Water Now"
        android:textSize="10sp"
        android:textColor="@color/app_background"
        android:backgroundTint="@color/primary_green"
        android:gravity="center"
        android:paddingHorizontal="13dp"
        app:cornerRadius="18dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>