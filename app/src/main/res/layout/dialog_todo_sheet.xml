<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Drag Handle Indicator -->
        <View
            android:id="@+id/view_todo_drag_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/divider"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Header Icon Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_todo_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary_green"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/view_todo_drag_handle"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_white"
                android:layout_gravity="center"
                android:contentDescription="To-Do Icon"
                app:tint="@color/white"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Header Title Text -->
        <TextView
            android:id="@+id/tv_todo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Today's To-Do"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:layout_marginStart="12dp"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="@id/card_todo_icon"
            app:layout_constraintTop_toTopOf="@id/card_todo_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_todo_icon" />

        <!-- Divider Line -->
        <View
            android:id="@+id/view_todo_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/card_todo_icon" />

        <!-- Tasks List RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_todo_tasks_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/view_todo_divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>