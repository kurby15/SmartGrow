<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_splash_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- FIXED TOP LOGO SECTION (Hindi gumagalaw) -->
    <FrameLayout
        android:id="@+id/layout_top_logo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_reset_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/smartgrow_logo"
            app:tint="@color/white"
            android:contentDescription="SmartGrow Logo" />
    </FrameLayout>

    <!-- SCROLLABLE BOTTOM WHITE CARD SECTION (Dito lang mag-a-scroll ang form fields) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/white_card_top_rounded"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintHeight_percent="0.68"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/tv_reset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textSize="30sp"
                android:fontFamily="@font/inter_extrabold"
                android:textStyle="bold"
                android:textColor="@color/primary_green"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_reset_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a strong new password for your security."
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tv_reset_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/layout_form_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/tv_reset_subtitle"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- New Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Password"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/text_secondary"
                        app:boxBackgroundMode="none">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_new_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Enter new password"
                            android:textColorHint="@color/text_secondary"
                            android:inputType="textPassword"
                            android:paddingHorizontal="18dp"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/inter_medium" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Confirm Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Password"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginBottom="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/text_secondary"
                        app:boxBackgroundMode="none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFamily="@font/inter_medium"
                            android:hint="Re-enter new password"
                            android:inputType="textPassword"
                            android:paddingHorizontal="18dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Update Password Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_password"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Update Password"
                android:textSize="16sp"
                android:fontFamily="@font/inter_extrabold"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary_green"
                app:cornerRadius="26dp"
                android:elevation="4dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/layout_form_reset" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>