<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_splash_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- FIXED TOP LOGO SECTION -->
    <FrameLayout
        android:id="@+id/layout_top_logo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_reset_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/smartgrow_logo"
            app:tint="@color/white"
            android:contentDescription="SmartGrow Logo" />

    </FrameLayout>

    <!-- SCROLLABLE BOTTOM WHITE CARD SECTION -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/white_card_top_rounded"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintHeight_percent="0.68"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_reset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Password"
                android:textSize="30sp"
                android:fontFamily="@font/inter_extrabold"
                android:textStyle="bold"
                android:textColor="@color/primary_green"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- SUBTITLE -->
            <TextView
                android:id="@+id/tv_reset_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify identity and create a strong new password."
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tv_reset_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- PASSWORD FORM -->
            <LinearLayout
                android:id="@+id/layout_form_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/tv_reset_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- OLD PASSWORD LABEL (Hidden) -->
                <TextView
                    android:id="@+id/tv_old_password_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Old Password"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone" />

                <!-- OLD PASSWORD FIELD (Hidden) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_old_password"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/text_secondary"
                        app:boxBackgroundMode="none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_old_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Enter current password"
                            android:textColorHint="@color/text_secondary"
                            android:inputType="textPassword"
                            android:paddingHorizontal="18dp"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/inter_medium"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- NEW PASSWORD LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Password"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:layout_marginBottom="6dp" />

                <!-- NEW PASSWORD FIELD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/text_secondary"
                        app:boxBackgroundMode="none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_new_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Enter new password"
                            android:textColorHint="@color/text_secondary"
                            android:inputType="textPassword"
                            android:paddingHorizontal="18dp"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/inter_medium"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- CONFIRM PASSWORD LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Password"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:layout_marginBottom="6dp" />

                <!-- CONFIRM PASSWORD FIELD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginBottom="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/text_secondary"
                        app:boxBackgroundMode="none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFamily="@font/inter_medium"
                            android:hint="Re-enter new password"
                            android:inputType="textPassword"
                            android:paddingHorizontal="18dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="12sp"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- RESET PASSWORD BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_password"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Reset Password"
                android:textSize="16sp"
                android:fontFamily="@font/inter_extrabold"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary_green"
                android:elevation="4dp"
                android:layout_marginTop="24dp"
                app:cornerRadius="26dp"
                app:layout_constraintTop_toBottomOf="@id/layout_form_reset"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>