<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_terms_service"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="0dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btn_back_terms"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/primary_green"
                android:contentDescription="Go back" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/inter_extrabold"
                android:text="Terms of Service"
                android:textColor="@color/primary_green"
                android:textSize="16sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- 1. Acceptance of Agreement -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="1. Acceptance of Agreement"
                android:textColor="@color/profile_title_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/inter_semibold"
                android:lineSpacingMultiplier="1.3"
                android:text="By accessing or using this system, you agree to comply with and be bound by these Terms of Service. If you do not agree to these terms, please do not use the application or any related platform features."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 2. User Obligations & Conduct -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="2. User Obligations &amp; Conduct"
                android:textColor="@color/profile_title_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/inter_semibold"
                android:lineSpacingMultiplier="1.3"
                android:text="Users agree to use the services solely for constructive purposes. Any form of misuse, distribution of unlawful content within collaborative spaces, or attempts to disrupt system servers will lead to immediate account limitation or termination."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 3. Intellectual Property Rights -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="3. Intellectual Property Rights"
                android:textColor="@color/profile_title_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/inter_semibold"
                android:lineSpacingMultiplier="1.3"
                android:text="All branding layout materials, computational assets, application architectures, and underlying detection models are the direct property of the developers and are protected under state copyright and proprietary laws."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 4. Disclaimer & Limitations -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="4. Disclaimer &amp; Limitations"
                android:textColor="@color/profile_title_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/inter_semibold"
                android:lineSpacingMultiplier="1.3"
                android:text="The application interface features and identification assessments are served on an 'as-is' standard. While we prioritize extreme reliability, we make no explicit warranties that processes will operate completely error-free over continuous periods."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider" />

            <!-- Last Updated -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Last Updated: September 2026"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>