<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <ImageButton
        android:id="@+id/btn_register_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/back_button_login"
        android:contentDescription="Back"
        android:scaleType="centerInside"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layout_register_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_register_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_register_mini_logo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/smartgrow_logo"
            app:tint="#12A703"
            android:contentDescription="SmartGrow" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="#0C6211" />

            <TextView
                android:id="@+id/tv_step_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 4 of 5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="#555555" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_indicator_bars"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:weightSum="5"
        app:layout_constraintTop_toBottomOf="@id/layout_register_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/indicator_step1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_green" />

        <View
            android:id="@+id/indicator_step2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_green" />

        <View
            android:id="@+id/indicator_step3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_green" />

        <View
            android:id="@+id/indicator_step4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_green" />

        <View
            android:id="@+id/indicator_step5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/indicator_gray" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_question_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What is your gardening level?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0C6211"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/layout_indicator_bars" />

    <TextView
        android:id="@+id/tv_question_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="We will adjust our learning suggestions for you."
        android:textSize="13sp"
        android:textColor="#666666"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_question_title" />

    <LinearLayout
        android:id="@+id/layout_choices_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_question_subtitle"
        app:layout_constraintBottom_toTopOf="@id/btn_register_next">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_choice1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="6dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_choice1_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Absolute Beginner (Zero knowledge)"
                android:textSize="15sp"
                android:textColor="#333333"
                android:fontFamily="@font/poppins" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_choice2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="6dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_choice2_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Intermediate Grower (Some experience)"
                android:textSize="15sp"
                android:textColor="#333333"
                android:fontFamily="@font/poppins" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_choice3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="6dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_choice3_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Advanced Plant Parent"
                android:textSize="15sp"
                android:textColor="#333333"
                android:fontFamily="@font/poppins" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_choice4"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="6dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_choice4_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Professional / Academic Researcher"
                android:textSize="15sp"
                android:textColor="#333333"
                android:fontFamily="@font/poppins" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register_next"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Next"
        android:textSize="18sp"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:backgroundTint="#0C6211"
        app:cornerRadius="16dp"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
