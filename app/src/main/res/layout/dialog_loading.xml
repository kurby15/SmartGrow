<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌟 Glassmorphism Card Frame -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loading_card"
        android:layout_width="220dp"
        android:layout_height="240dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#F9FBF9"
        app:strokeColor="#E2EBE2"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 🔄 Custom Green Spinner Frame -->
            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:indeterminateDrawable="@drawable/loading_spinner"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tv_progress_percentage"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <!-- 🌿 Ang Logo sa Gitna ng Spinner -->
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="Loading Logo"
                android:src="@drawable/smartgrow_logo"
                app:layout_constraintTop_toTopOf="@id/loading_progress"
                app:layout_constraintBottom_toBottomOf="@id/loading_progress"
                app:layout_constraintLeft_toLeftOf="@id/loading_progress"
                app:layout_constraintRight_toRightOf="@id/loading_progress" />

            <!-- 🔢 Modern 1-100% Percent Counter Text -->
            <TextView
                android:id="@+id/tv_progress_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0%"
                android:textColor="#0C6211"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/loading_progress"
                app:layout_constraintBottom_toTopOf="@id/tv_loading_message"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <!-- 💬 Dynamic Changing Messages -->
            <TextView
                android:id="@+id/tv_loading_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Preparing app..."
                android:textColor="#556655"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tv_progress_percentage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 🌿 SEEDLINGS/LEAVES ANIMATION LAYERS (Naka-angkla sa gilid ng Card natin) -->
    <ImageView
        android:id="@+id/leaf_bottom_left"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_left"
        android:rotation="-30"
        app:layout_constraintBottom_toBottomOf="@id/loading_card"
        app:layout_constraintRight_toLeftOf="@id/loading_card"
        android:layout_marginRight="-10dp"
        android:layout_marginBottom="20dp"/>

    <ImageView
        android:id="@+id/leaf_top_right"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_right"
        android:rotation="45"
        app:layout_constraintTop_toTopOf="@id/loading_card"
        app:layout_constraintLeft_toRightOf="@id/loading_card"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="20dp"/>

    <ImageView
        android:id="@+id/leaf_top_left"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_left"
        android:rotation="-60"
        app:layout_constraintTop_toTopOf="@id/loading_card"
        app:layout_constraintRight_toLeftOf="@id/loading_card"
        android:layout_marginRight="-8dp"
        android:layout_marginTop="50dp"/>

    <ImageView
        android:id="@+id/leaf_bottom_right"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_right"
        android:rotation="15"
        app:layout_constraintBottom_toBottomOf="@id/loading_card"
        app:layout_constraintLeft_toRightOf="@id/loading_card"
        android:layout_marginLeft="-12dp"
        android:layout_marginBottom="60dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>