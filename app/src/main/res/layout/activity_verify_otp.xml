<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_splash_bg">

    <FrameLayout
        android:id="@+id/layout_top_logo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_otp_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/smartgrow_logo" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/white_card_top_rounded"
        android:fillViewport="true"
        app:layout_constraintHeight_percent="0.68"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_otp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification"
                android:textSize="36sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:textColor="#0C6211"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_otp_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the 4-digit code sent to your email."
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tv_otp_title" />

            <LinearLayout
                android:id="@+id/layout_otp_boxes"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/tv_otp_subtitle">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">
                    <EditText
                        android:id="@+id/et_otp_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">
                    <EditText
                        android:id="@+id/et_otp_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">
                    <EditText
                        android:id="@+id/et_otp_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="55dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="6dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">
                    <EditText
                        android:id="@+id/et_otp_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify_code"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Verify Code"
                android:textSize="18sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="#0C6211"
                app:cornerRadius="16dp"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@id/layout_otp_boxes" />

            <TextView
                android:id="@+id/tv_resend_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend code in 0:59"
                android:textColor="#666666"
                android:fontFamily="@font/poppins"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/btn_verify_code"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>