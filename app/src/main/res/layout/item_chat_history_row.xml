<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Chat Icon -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_chat"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        app:tint="@color/text_secondary" />

    <!-- Container for Title & Date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- History Title -->
        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pagsisimula ng SmartGrow UI Develo..."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/inter_medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- History Date/Time (Populated by AiHistoryAdapter) -->
        <TextView
            android:id="@+id/tv_history_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Aug 16, 2026 • 06:51 PM"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/inter_medium"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Delete Button -->
    <ImageView
        android:id="@+id/iv_delete_history"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Delete history item"
        app:tint="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>