<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nature_earth">

    <!-- Scalable Aura Background -->
    <View
        android:id="@+id/view_background_aura"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.2"
        android:background="@drawable/logo_glow_circle"
        app:layout_constraintWidth_percent="0.75"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <!-- Scalable Logo -->
    <ImageView
        android:id="@+id/img_splash_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/smartgrow_logo"
        android:contentDescription="SmartGrow Organic Logo"
        app:tint="#81C784"
        app:layout_constraintWidth_percent="0.38"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="@id/view_background_aura"
        app:layout_constraintBottom_toBottomOf="@id/view_background_aura"
        app:layout_constraintStart_toStartOf="@id/view_background_aura"
        app:layout_constraintEnd_toEndOf="@id/view_background_aura" />

    <LinearLayout
        android:id="@+id/layout_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="32dp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toBottomOf="@id/view_background_aura"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartGrow"
            android:textSize="34sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:letterSpacing="-0.01" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_version_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Version 1.0.0"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:alpha="0.3"
        android:fontFamily="@font/poppins"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>