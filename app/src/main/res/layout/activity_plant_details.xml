<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- STATIC HEADER CONTENT -->
    <LinearLayout
        android:id="@+id/layout_static_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="4dp"
        android:background="@color/app_background">

        <!-- TOP IMAGE COLLAGE GRID -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Main Left Image -->
                <ImageView
                    android:id="@+id/iv_plant_main"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:contentDescription="Main plant image"
                    android:scaleType="centerCrop"
                    tools:src="@android:color/darker_gray" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/background" />

                <!-- Right Image Grid Stack -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_plant_match_1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:contentDescription="Plant match sample 1"
                        android:scaleType="centerCrop"
                        tools:src="@android:color/darker_gray" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/background" />

                    <ImageView
                        android:id="@+id/iv_plant_match_2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:contentDescription="Plant match sample 2"
                        android:scaleType="centerCrop"
                        tools:src="@android:color/darker_gray" />
                </LinearLayout>
            </LinearLayout>

            <!-- Back Arrow Button -->
            <ImageView
                android:id="@+id/ib_back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Navigate back"
                android:background="@drawable/bg_match"
                android:src="@drawable/ic_back2"
                app:tint="#FFFFFF" />

            <!-- Match Confidence Badge -->
            <TextView
                android:id="@+id/tv_match_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_match"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/inter_extrabold"
                tools:text="98% Match Confidence" />

        </RelativeLayout>

        <!-- TITLE & SCIENTIFIC NAME HEADER  -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- AI Chat Button (Anchored to Right Top) -->
            <ImageView
                android:id="@+id/btn_plant_ai_chat"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Chat with AI"
                android:focusable="true"
                android:src="@drawable/bot_welcoming"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Thought Bubble Group (Placed Horizontally Left of the Icon) -->
            <LinearLayout
                android:id="@+id/layout_thought_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginEnd="-10dp"
                app:layout_constraintBottom_toBottomOf="@id/btn_plant_ai_chat"
                app:layout_constraintEnd_toStartOf="@id/btn_plant_ai_chat"
                app:layout_constraintTop_toTopOf="@id/btn_plant_ai_chat"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_click_me_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_thought_bubble"
                    android:elevation="4dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Click me!"
                    android:textColor="#F44336"
                    android:textSize="10sp" />

                <!-- Horizontally aligned dots pointing to the bot -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="2dp">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_thought_circle" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_thought_circle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Plant Title -->
            <TextView
                android:id="@+id/tv_plant_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/inter_extrabold"
                android:includeFontPadding="false"
                android:textColor="@color/primary_green"
                android:textSize="22sp"
                app:layout_constraintEnd_toStartOf="@id/layout_thought_bubble"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Cabbage" />

            <!-- Scientific Name & Speaker Row -->
            <LinearLayout
                android:id="@+id/layout_scientific"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_plant_title">

                <TextView
                    android:id="@+id/tv_scientific_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light_italic"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Brassica oleracea var. capitata" />

                <ImageView
                    android:id="@+id/ib_speaker"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Pronunciation"
                    android:src="@drawable/ic_speaker"
                    app:tint="#81C784" />
            </LinearLayout>

            <!-- Aliases -->
            <TextView
                android:id="@+id/tv_aliases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_scientific"
                tools:text="Also known as: Repolyo" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- TABS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/tab_overview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_active"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="Overview"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_care"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="Care"
                    android:textColor="@color/primary_green"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_explore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="Discover"
                    android:textColor="@color/primary_green"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- HEALTH BANNER CARD (Static) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_health_img"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/iv_health_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@android:color/darker_gray" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/card_health_img"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Health Score"
                            android:textColor="@color/primary_green"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_extrabold"/>
                        <TextView
                            android:id="@+id/tv_health_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#81C784"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_extrabold"
                            tools:text="92/100" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pb_health_score"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="92" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: "
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_extrabold"/>
                        <TextView
                            android:id="@+id/tv_health_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#81C784"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_extrabold"
                            tools:text="Healthy!" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- SCROLLABLE CONTENT (FRAGMENT CONTAINER) -->
    <FrameLayout
        android:id="@+id/plant_details_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_static_header"
        android:layout_above="@id/layout_bottom_bar" />

    <!-- FLOATING BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="@color/app_background">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_to_garden_bottom"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#3a7d44"
            android:text="Save to My Garden"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/inter_extrabold"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_my_garden"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>