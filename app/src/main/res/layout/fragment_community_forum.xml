<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_forum"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- FrameLayout Wrapper -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ========================================== -->
        <!-- ACTUAL CONTENT (Hidden Initially)          -->
        <!-- ========================================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/forum_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Community Forum Title -->
                <TextView
                    android:id="@+id/tv_community_forum_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Community Forum"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green"
                    android:fontFamily="@font/inter_extrabold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ========================================== -->
                <!-- WHAT'S ON YOUR MIND CARD                   -->
                <!-- ========================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_community_forum_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_user"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="3dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_user"
                            app:shapeAppearanceOverlay="@style/CircleImageView"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_mind"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="What's on your mind?"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_semibold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_camera_icon"
                            app:layout_constraintStart_toEndOf="@+id/img_user"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/btn_camera_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_camera_forum"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="@color/text_secondary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================================== -->
                <!-- FORUM FEED                                 -->
                <!-- ========================================== -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_forum_feed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@id/card_mind"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:listitem="@layout/item_forum_post" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- ========================================== -->
        <!-- SKELETON LOADING                           -->
        <!-- UNCHANGED                                   -->
        <!-- ========================================== -->
        <include
            android:id="@+id/include_forum_skeleton"
            layout="@layout/layout_forum_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

    </FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>