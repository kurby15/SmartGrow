<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌟 Glassmorphism / Dark Theme Card Frame -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loading_card"
        android:layout_width="240dp"
        android:layout_height="260dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 🔄 Custom Green Spinner Frame -->
            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:indeterminateDrawable="@drawable/loading_spinner"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tv_progress_percentage"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <!-- 🌿 SmartGrow Logo inside Spinner -->
            <ImageView
                android:id="@+id/iv_loading_logo"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:contentDescription="SmartGrow Logo"
                android:src="@drawable/smartgrow_logo"
                app:layout_constraintTop_toTopOf="@id/loading_progress"
                app:layout_constraintBottom_toBottomOf="@id/loading_progress"
                app:layout_constraintLeft_toLeftOf="@id/loading_progress"
                app:layout_constraintRight_toRightOf="@id/loading_progress" />

            <!-- 🔢 Modern Progress Percentage Counter -->
            <TextView
                android:id="@+id/tv_progress_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0%"
                android:textColor="@color/primary_green"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/loading_progress"
                app:layout_constraintBottom_toTopOf="@id/tv_loading_message"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <!-- 💬 Dynamic Plant Analysis Message -->
            <TextView
                android:id="@+id/tv_loading_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Scanning plant features..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tv_progress_percentage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 🌸 BLOOMING FLOWERS / LEAVES ANIMATION LAYERS -->
    <ImageView
        android:id="@+id/flower_bottom_left"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_left"
        android:rotation="-30"
        app:layout_constraintBottom_toBottomOf="@id/loading_card"
        app:layout_constraintRight_toLeftOf="@id/loading_card"
        android:layout_marginRight="-12dp"
        android:layout_marginBottom="24dp"/>

    <ImageView
        android:id="@+id/flower_top_right"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_right"
        android:rotation="45"
        app:layout_constraintTop_toTopOf="@id/loading_card"
        app:layout_constraintLeft_toRightOf="@id/loading_card"
        android:layout_marginLeft="-12dp"
        android:layout_marginTop="24dp"/>

    <ImageView
        android:id="@+id/flower_top_left"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_left"
        android:rotation="-60"
        app:layout_constraintTop_toTopOf="@id/loading_card"
        app:layout_constraintRight_toLeftOf="@id/loading_card"
        android:layout_marginRight="-8dp"
        android:layout_marginTop="56dp"/>

    <ImageView
        android:id="@+id/flower_bottom_right"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:visibility="invisible"
        android:src="@drawable/ic_leaf_right"
        android:rotation="15"
        app:layout_constraintBottom_toBottomOf="@id/loading_card"
        app:layout_constraintLeft_toRightOf="@id/loading_card"
        android:layout_marginLeft="-14dp"
        android:layout_marginBottom="64dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>