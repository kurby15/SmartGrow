<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_signup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- ================= FIXED HEADER ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="0dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- BACK BUTTON -->
            <ImageView
                android:id="@+id/btn_register_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/back_button_login"
                app:tint="@color/primary_green"
                android:contentDescription="Go back" />

            <!-- CENTERED TITLE -->
            <TextView
                android:id="@+id/tv_signup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/inter_extrabold"
                android:text="Create Account"
                android:textColor="@color/primary_green"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ================= SCROLLABLE CONTENT ================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- ================= INTRO ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_extrabold"
                android:text="Create your account"
                android:textColor="@color/profile_title_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Fill in your details to get started with SmartGrow."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />


            <!-- ================= FORM CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- ================= FULL NAME ================= -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/inter_extrabold"
                        android:text="Full Name"
                        android:textColor="@color/profile_title_color"
                        android:textSize="12sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/app_background"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <EditText
                            android:id="@+id/et_signup_fullname"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter_semibold"
                            android:hint="Enter your full name"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/profile_title_color"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="12sp" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- ================= EMAIL ================= -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/inter_extrabold"
                        android:text="Email Address"
                        android:textColor="@color/profile_title_color"
                        android:textSize="12sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/app_background"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <EditText
                            android:id="@+id/et_signup_email"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter_semibold"
                            android:hint="example@gmail.com"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/profile_title_color"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="12sp" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- ================= PASSWORD ================= -->

                    <TextView
                        android:id="@+id/tv_label_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/inter_extrabold"
                        android:text="Password"
                        android:textColor="@color/profile_title_color"
                        android:textSize="12sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="@color/app_background"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/text_secondary"
                            app:boxBackgroundMode="none">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_signup_password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:hint="Enter your password"
                                android:inputType="textPassword"
                                android:paddingStart="12dp"
                                android:paddingEnd="48dp"
                                android:textColor="@color/profile_title_color"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter_semibold" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- ================= PASSWORD REQUIREMENTS ================= -->

                    <LinearLayout
                        android:id="@+id/layout_password_requirements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_password_requirements"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- LENGTH -->

                        <LinearLayout
                            android:id="@+id/row_req_length"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tv_req_length_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="!"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#E53935"
                                android:background="@drawable/bg_password_requirement_icon" />

                            <TextView
                                android:id="@+id/tv_req_length"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Minimum of 8–12 characters"
                                android:textColor="#E53935"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                        </LinearLayout>


                        <!-- UPPERCASE -->

                        <LinearLayout
                            android:id="@+id/row_req_uppercase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tv_req_uppercase_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="!"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#E53935"
                                android:background="@drawable/bg_password_requirement_icon" />

                            <TextView
                                android:id="@+id/tv_req_uppercase"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="At least one uppercase letter"
                                android:textColor="#E53935"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                        </LinearLayout>


                        <!-- NUMBER -->

                        <LinearLayout
                            android:id="@+id/row_req_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tv_req_number_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="!"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#E53935"
                                android:background="@drawable/bg_password_requirement_icon" />

                            <TextView
                                android:id="@+id/tv_req_number"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="At least one number"
                                android:textColor="#E53935"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                        </LinearLayout>


                        <!-- SPECIAL CHARACTER -->

                        <LinearLayout
                            android:id="@+id/row_req_special"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tv_req_special_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="!"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#E53935"
                                android:background="@drawable/bg_password_requirement_icon" />

                            <TextView
                                android:id="@+id/tv_req_special"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="At least one special character"
                                android:textColor="#E53935"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter_medium" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- ================= CONFIRM PASSWORD ================= -->

                    <TextView
                        android:id="@+id/tv_label_confirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/inter_extrabold"
                        android:text="Confirm Password"
                        android:textColor="@color/profile_title_color"
                        android:textSize="12sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="4dp"
                        app:cardBackgroundColor="@color/app_background"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/text_secondary"
                            app:boxBackgroundMode="none">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_confirm_password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:hint="Re-enter password"
                                android:inputType="textPassword"
                                android:paddingStart="12dp"
                                android:paddingEnd="48dp"
                                android:textColor="@color/profile_title_color"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter_semibold" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= SIGN UP BUTTON ================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_up"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/primary_green"
                android:fontFamily="@font/inter_extrabold"
                android:text="Sign Up"
                android:textColor="@color/card_background"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:elevation="4dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================= LOADING INDICATOR ================= -->

    <ProgressBar
        android:id="@+id/pb_signup_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/primary_green" />

</LinearLayout>
