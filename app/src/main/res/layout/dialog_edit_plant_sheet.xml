<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:paddingTop="16dp"
    android:paddingHorizontal="24dp">

    <!-- Drag Handle Indicator -->
    <View
        android:id="@+id/view_edit_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scrollable container - dynamic high performance constraints -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_edit_plant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:fillViewport="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/view_edit_drag_handle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tv_edit_plant_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Plant Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Plant Name Section -->
            <TextView
                android:id="@+id/lbl_edit_plant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plant Name:"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_edit_input_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <EditText
                    android:id="@+id/et_edit_plant_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="e.g., My Healing Plant"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:importantForAutofill="no" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Species Section -->
            <TextView
                android:id="@+id/lbl_edit_plant_species"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Species/Type:"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_edit_input_species"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <EditText
                    android:id="@+id/et_edit_plant_species"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="e.g., Lagundi"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:importantForAutofill="no" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Medicinal Use Section -->
            <TextView
                android:id="@+id/lbl_edit_plant_medicinal_use"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicinal Use / Purpose:"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_edit_input_medicinal_use"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <EditText
                    android:id="@+id/et_edit_plant_medicinal_use"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="e.g., For Cough, Asthma, &amp; Fever"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="16dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:importantForAutofill="no" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Date Section -->
            <TextView
                android:id="@+id/lbl_edit_plant_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins"
                android:text="Date Planted:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_edit_input_date"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">
                    <EditText
                        android:id="@+id/et_edit_plant_date"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/img_edit_calendar_icon"
                        android:background="@android:color/transparent"
                        android:hint="dd/mm/yyyy"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:focusable="false"
                        android:clickable="true"
                        android:fontFamily="@font/poppins"
                        android:importantForAutofill="no"
                        android:inputType="none" />
                    <ImageView
                        android:id="@+id/img_edit_calendar_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Calendar Icon"
                        android:src="@drawable/ic_calendar_gray"
                        app:tint="@color/text_secondary" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Image Upload Section -->
            <TextView
                android:id="@+id/lbl_edit_plant_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Plant Photo:"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_edit_upload_image"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:id="@+id/layout_edit_image_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="Camera Icon"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/text_secondary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Update photo or take new snap"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/img_edit_plant_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Plant Image Preview"
                        android:visibility="gone" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_plant_changes"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                app:backgroundTint="@color/primary_green"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>