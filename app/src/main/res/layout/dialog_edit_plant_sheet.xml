<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:padding="24dp">

    <View
        android:id="@+id/view_edit_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E0E0E0"
        android:backgroundTint="#CCCCCC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_edit_plant_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Plant Details"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/view_edit_drag_handle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lbl_edit_plant_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name:"
        android:textStyle="bold"
        android:textColor="#111111"
        android:textSize="14sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_edit_plant_title"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_edit_input_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFDF3"
        app:strokeWidth="1dp"
        app:strokeColor="#F2ECE1"
        app:layout_constraintTop_toBottomOf="@id/lbl_edit_plant_name">
        <EditText
            android:id="@+id/et_edit_plant_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="e.g., My Healing Plant"
            android:textColorHint="#94A3B3"
            android:textColor="#111111"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/lbl_edit_plant_species"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Species/Type:"
        android:textStyle="bold"
        android:textColor="#111111"
        android:textSize="14sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_edit_input_name"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_edit_input_species"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFDF3"
        app:strokeWidth="1dp"
        app:strokeColor="#F2ECE1"
        app:layout_constraintTop_toBottomOf="@id/lbl_edit_plant_species">
        <EditText
            android:id="@+id/et_edit_plant_species"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="e.g., Lagundi"
            android:textColorHint="#94A3B3"
            android:textColor="#111111"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/lbl_edit_plant_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins"
        android:text="Date Planted:"
        android:textColor="#111111"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_edit_input_species" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_edit_input_date"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFDF3"
        app:strokeWidth="1dp"
        app:strokeColor="#F2ECE1"
        app:layout_constraintTop_toBottomOf="@id/lbl_edit_plant_date">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">
            <EditText
                android:id="@+id/et_edit_plant_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@id/img_edit_calendar_icon"
                android:background="@android:color/transparent"
                android:hint="dd/mm/yyyy"
                android:textColorHint="#94A3B3"
                android:textColor="#111111"
                android:textSize="14sp"
                android:focusable="false"
                android:clickable="true"
                android:fontFamily="@font/poppins" />
            <ImageView
                android:id="@+id/img_edit_calendar_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_calendar_gray"
                app:tint="#555555" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/lbl_edit_plant_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Health Status"
        android:textStyle="bold"
        android:textColor="#111111"
        android:textSize="14sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_edit_input_date"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_edit_input_status"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFDF3"
        app:strokeWidth="1dp"
        app:strokeColor="#F2ECE1"
        app:layout_constraintTop_toBottomOf="@id/lbl_edit_plant_status">
        <Spinner
            android:id="@+id/spinner_edit_plant_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:backgroundTint="#856404"
            android:spinnerMode="dropdown" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/lbl_edit_plant_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plant Photo:"
        android:textStyle="bold"
        android:textColor="#111111"
        android:textSize="14sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_edit_input_status"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_edit_upload_image"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8F9FA"
        app:strokeWidth="1dp"
        app:strokeColor="#DDE2E5"
        app:layout_constraintTop_toBottomOf="@id/lbl_edit_plant_image">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layout_edit_image_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#A0AAB2" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Take a photo or Upload"
                    android:textColor="#7A869A"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/img_edit_plant_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_plant_changes"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="Save Changes"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:paddingHorizontal="24dp"
        app:backgroundTint="#856404"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/card_edit_upload_image"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>