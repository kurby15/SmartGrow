<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161719"
    android:orientation="vertical">

    <!-- ==================== TOP NAVIGATION TABS ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Tab 1: My Garden / My Pots (Active State Example) -->
        <LinearLayout
            android:id="@+id/tab_my_garden"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_my_garden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Garden"
                android:textColor="#54D194"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Active Line Indicator -->
            <View
                android:id="@+id/indicator_my_garden"
                android:layout_width="20dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_active_tab_indicator"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Tab 2: Snap History (Inactive State Example) -->
        <LinearLayout
            android:id="@+id/tab_snap_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tab_snap_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snap History"
                android:textColor="#72777D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Active Line Indicator (Hidden by default when inactive) -->
            <View
                android:id="@+id/indicator_snap_history"
                android:layout_width="20dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_active_tab_indicator"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <!-- ==================== SEARCH & FILTER SECTION ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Search Input -->
            <EditText
                android:id="@+id/et_search_plants"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input_rounded"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawableTint="#80858C"
                android:drawablePadding="10dp"
                android:hint="Search plants"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80858C"
                android:textSize="15sp" />

            <!-- Reminder Filter Button -->
            <ImageButton
                android:id="@+id/ib_filter_reminder"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_input_rounded"
                android:padding="10dp"
                android:src="@drawable/remider_plant"
                app:tint="#A8ADB2"
                tools:ignore="ContentDescription" />

            <!-- More / Sort Filter Button -->
            <ImageButton
                android:id="@+id/ib_filter_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_input_rounded"
                android:padding="10dp"
                android:src="@drawable/more"
                app:tint="#A8ADB2"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <!-- ==================== PLANT RECYCLERVIEW LIST ==================== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_plant_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

    </LinearLayout>

</LinearLayout>