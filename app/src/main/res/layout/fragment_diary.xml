<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFA"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <!-- Headers: Naka-0dp (match_constraint) para hindi maputol sa maliliit na screens -->
    <TextView
        android:id="@+id/tv_diary_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Plant Diary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:fontFamily="@font/poppins"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_diary_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Track your plant growth journey"
        android:textColor="#666666"
        android:textSize="14sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_diary_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search Row -->
    <LinearLayout
        android:id="@+id/layout_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/tv_diary_subtitle">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#EAEAEA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search_gray"
                    app:tint="#555555" />

                <EditText
                    android:id="@+id/et_search_plants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Search plants"
                    android:textColorHint="#999999"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:paddingStart="8dp"
                    android:maxLines="1"
                    android:inputType="text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_btn_add_new_diary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#0C6211"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add_plus_green"
                app:tint="#FFFFFF"
                android:layout_gravity="center" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 🌟 THE MAGIC TRICK: height="0dp"
         Ito ang magfi-fit ng listahan mo hanggang sa pinaka-baba ng screen,
         kahit gaano pa kaliit o kalaki ang phone ng user! 🌟 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_plant_diary_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_search_row"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_plant_card"
        tools:itemCount="5" />

</androidx.constraintlayout.widget.ConstraintLayout>