<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_splash_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- TOP LOGO -->
    <FrameLayout
        android:id="@+id/layout_top_logo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_forgot_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/smartgrow_logo"
            app:tint="@color/white"
            android:contentDescription="SmartGrow Logo" />

    </FrameLayout>

    <!-- WHITE CONTENT CARD -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/white_card_top_rounded"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintHeight_percent="0.68"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_forgot_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password"
                android:textSize="30sp"
                android:fontFamily="@font/inter_extrabold"
                android:textStyle="bold"
                android:textColor="@color/primary_green"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- SUBTITLE -->
            <TextView
                android:id="@+id/tv_forgot_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your registered email address to receive&#10;your 4-digit verification code."
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_forgot_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- FORM -->
            <LinearLayout
                android:id="@+id/layout_form_forgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="36dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/tv_forgot_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- EMAIL LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="@color/primary_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginBottom="7dp" />

                <!-- EMAIL FIELD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="1dp"
                    android:layout_marginBottom="4dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <!-- EMAIL ICON -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            android:contentDescription="Email"
                            app:tint="@color/text_secondary" />

                        <!-- EMAIL INPUT -->
                        <EditText
                            android:id="@+id/et_forgot_email"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:hint="example@email.com"
                            android:textColorHint="@color/text_secondary"
                            android:inputType="textEmailAddress"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/inter_medium"
                            android:singleLine="true" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SEND CODE BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_code"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Send Code"
                android:textSize="14sp"
                android:fontFamily="@font/inter_extrabold"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary_green"
                android:elevation="6dp"
                android:layout_marginTop="40dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/layout_form_forgot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- BACK TO LOGIN -->
            <TextView
                android:id="@+id/tv_back_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Sign In"
                android:textColor="@color/primary_green"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:textSize="14sp"
                android:padding="8dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/btn_send_code"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>