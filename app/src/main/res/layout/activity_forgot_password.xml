<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_splash_bg">

    <FrameLayout
        android:id="@+id/layout_top_logo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_forgot_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/smartgrow_logo"
            android:contentDescription="SmartGrow Logo" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/white_card_top_rounded"
        android:fillViewport="true"
        app:layout_constraintHeight_percent="0.68"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_forgot_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password"
                android:textSize="32sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:textColor="#0C6211"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_forgot_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your registered email address to receive your 4-digit verification code."
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_forgot_title" />

            <LinearLayout
                android:id="@+id/layout_form_forgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@id/tv_forgot_subtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#0C6211"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="4dp"
                    app:cardElevation="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#F6F4F4">

                    <EditText
                        android:id="@+id/et_forgot_email"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="example@email.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:fontFamily="@font/poppins" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_code"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Send Code"
                android:textSize="18sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:backgroundTint="#0C6211"
                app:cornerRadius="16dp"
                android:elevation="6dp"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/layout_form_forgot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_back_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Sign In"
                android:textColor="#0C6211"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textSize="15sp"
                android:padding="8dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/btn_send_code"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>