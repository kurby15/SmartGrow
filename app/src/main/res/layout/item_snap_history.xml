<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.github.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Plant Image Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_image_container"
            android:layout_width="110dp"
            android:layout_height="90dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            app:cardBackgroundColor="@color/app_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_plant_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:color/darker_gray"
                tools:ignore="ContentDescription" />

        </com.google.android.material.card.MaterialCardView>

        <!-- More Options Icon -->
        <ImageView
            android:id="@+id/ib_more_options"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignTop="@id/text_container"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-5dp"
            android:padding="7dp"
            android:src="@drawable/ic_more"
            app:tint="@color/text_primary"
            tools:ignore="ContentDescription" />

        <!-- Text Container -->
        <LinearLayout
            android:id="@+id/text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/ib_more_options"
            android:layout_toEndOf="@id/card_image_container"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_common_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Monstera Deliciosa"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/inter_extrabold"/>

            <TextView
                android:id="@+id/tv_scientific_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:fontFamily="@font/inter_light_italic"
                android:visibility="gone"
                tools:text="Monstera deliciosa Liebm." />

        </LinearLayout>

        <!-- Circular Add/Check Icon Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fab_action"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignBottom="@id/card_image_container"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/primary_green"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_fab_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/ic_add_plus_green"
                app:tint="@color/app_background"
                tools:ignore="ContentDescription" />

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>