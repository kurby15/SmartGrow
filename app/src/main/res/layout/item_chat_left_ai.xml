<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:paddingHorizontal="4dp">

    <!-- Top section matching your original horizontal alignment (Avatar + Bubble) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="8dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/primary_green"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/smartgrow_logo"
                android:layout_gravity="center"
                app:tint="@color/white"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="0">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/divider"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/tv_chat_message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi! I'm your Plant Smart Care Assistant. How can I help you today?"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:maxWidth="260dp"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_chat_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- The newly added ChipGroup container for your follow-up chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_follow_up_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginLeft="36dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="4dp"
        app:singleLine="false" />

</LinearLayout>