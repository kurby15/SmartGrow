<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFA"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btn_back_privacy"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Go back"/>

    <TextView
        android:id="@+id/tv_privacy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:text="Privacy Policy"
        android:textAlignment="center"
        android:textColor="#111111"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/header_divider_privacy"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_privacy_title"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_divider_privacy"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="1. Introduction"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="We value your privacy and are committed to protecting your personal data. This Privacy Policy explains how we collect, use, and safe-keep your information when you utilize our smart services, features, and identification tools."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="2. Information We Collect"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="To provide optimal functionality, we may access certain elements such as device information, camera permissions for image detection features, and standard profile details submitted through interaction forms or community areas."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="3. Data Protection &amp; Security"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="We implement rigorous technical security measures to safeguard backend database transaction systems against unauthorized entry, alteration, or leaks, in tight alignment with established local data privacy regulations."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="4. Third-Party Services"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Any shared logs or assets analyzed via specialized algorithms remain anonymous and are strictly handled according to modern framework standards, ensuring no persistent personal files are disclosed to external actors without permission."
                android:textColor="#555555"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:fontFamily="@font/poppins" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Updated: June 2026"
                android:textColor="#999999"
                android:textSize="12sp"
                android:textAlignment="center"
                android:fontFamily="@font/poppins" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>