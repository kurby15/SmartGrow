<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/layout_privacy_policy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"

    android:background="@color/app_background"

    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- FIXED HEADER -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="55dp"

        app:cardBackgroundColor="@color/card_background"
        app:cardElevation="10dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- BACK BUTTON -->

            <ImageView
                android:id="@+id/btn_back_privacy"

                android:layout_width="36dp"
                android:layout_height="36dp"

                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"

                android:layout_marginStart="8dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:clickable="true"
                android:focusable="true"

                android:padding="12dp"

                android:src="@drawable/ic_back"

                app:tint="@color/primary_green"

                android:contentDescription="Go back" />


            <!-- HEADER TITLE -->

            <TextView
                android:id="@+id/tv_screen_title"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_centerInParent="true"

                android:fontFamily="@font/inter_extrabold"

                android:text="Privacy Policy"

                android:textColor="@color/primary_green"

                android:textSize="16sp"

                android:textStyle="bold" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- SCROLLABLE CONTENT -->

    <androidx.core.widget.NestedScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true"
        android:overScrollMode="never"

        android:clipToPadding="false">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp"

            android:clipChildren="false"
            android:clipToPadding="false">


            <!-- 1. INFORMATION COLLECTION -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="6dp"

                android:fontFamily="@font/inter_extrabold"

                android:text="1. Information We Collect"

                android:textColor="@color/profile_title_color"

                android:textSize="14sp"

                android:textStyle="bold" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="16dp"

                android:fontFamily="@font/inter_semibold"

                android:lineSpacingMultiplier="1.3"

                android:text="We collect information you provide directly to us when you create an account, such as your name, email address, and profile details. We also collect data automatically, including device information, location data (to provide localized agricultural insights), and images you upload for plant disease identification."

                android:textColor="@color/text_secondary"

                android:textSize="12sp" />


            <!-- 2. USE OF INFORMATION -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="6dp"

                android:fontFamily="@font/inter_extrabold"

                android:text="2. How We Use Your Information"

                android:textColor="@color/profile_title_color"

                android:textSize="14sp"

                android:textStyle="bold" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="16dp"

                android:fontFamily="@font/inter_semibold"

                android:lineSpacingMultiplier="1.3"

                android:text="The information we collect is used to provide, maintain, and improve the SmartGrow services. This includes processing AI plant analysis, providing weather-based recommendations, managing your community interactions, and communicating important system updates or security alerts."

                android:textColor="@color/text_secondary"

                android:textSize="12sp" />


            <!-- 3. DATA STORAGE & SECURITY -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="6dp"

                android:fontFamily="@font/inter_extrabold"

                android:text="3. Data Storage and Security"

                android:textColor="@color/profile_title_color"

                android:textSize="14sp"

                android:textStyle="bold" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="16dp"

                android:fontFamily="@font/inter_semibold"

                android:lineSpacingMultiplier="1.3"

                android:text="We prioritize the security of your data. We use industry-standard encryption and secure cloud infrastructure to store your personal information and agricultural data. We implement reasonable measures to protect against unauthorized access, alteration, or disclosure of your data."

                android:textColor="@color/text_secondary"

                android:textSize="12sp" />


            <!-- 4. THIRD-PARTY SERVICES -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="6dp"

                android:fontFamily="@font/inter_extrabold"

                android:text="4. Third-Party Services"

                android:textColor="@color/profile_title_color"

                android:textSize="14sp"

                android:textStyle="bold" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="24dp"

                android:fontFamily="@font/inter_semibold"

                android:lineSpacingMultiplier="1.3"

                android:text="SmartGrow utilizes third-party services such as Google Play Services, Firebase, and Mapbox. These providers may collect information used to identify you in accordance with their own privacy policies. We do not sell your personal data to third parties for marketing purposes."

                android:textColor="@color/text_secondary"

                android:textSize="12sp" />


            <!-- DIVIDER -->

            <View

                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginBottom="16dp"

                android:background="@color/divider" />


            <!-- LAST UPDATED -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:fontFamily="@font/inter_semibold"

                android:text="Last Updated: September 2026"

                android:textAlignment="center"

                android:textColor="@color/text_secondary"

                android:textSize="11sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
