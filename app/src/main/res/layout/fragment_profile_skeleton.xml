<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_skeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.7"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Profile Title Placeholder -->
        <View
            android:layout_width="140dp"
            android:layout_height="28dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_skeleton" />

        <!-- Profile Picture Placeholder -->
        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_skeleton_card" /> <!-- Pwede mong palitan ng circle drawable kung meron kang bg_skeleton_circle -->

        <!-- User Name Placeholder -->
        <View
            android:layout_width="180dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_skeleton" />

        <!-- User Email Placeholder -->
        <View
            android:layout_width="140dp"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_skeleton" />

        <!-- Profile Options/Cards Placeholders -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_skeleton_card" />

        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_skeleton_card" />

        <!-- Spacer to push logout button down if needed, or just standard margin -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logout Button Placeholder -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_skeleton_card" />

    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>