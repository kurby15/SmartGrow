<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- User Avatar Skeleton -->
        <View
            android:id="@+id/skeleton_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_skeleton_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- User Name Skeleton -->
        <View
            android:id="@+id/skeleton_name"
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintTop_toTopOf="@id/skeleton_avatar"
            app:layout_constraintStart_toEndOf="@id/skeleton_avatar" />

        <!-- Timestamp Skeleton -->
        <View
            android:id="@+id/skeleton_time"
            android:layout_width="70dp"
            android:layout_height="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintTop_toBottomOf="@id/skeleton_name"
            app:layout_constraintStart_toEndOf="@id/skeleton_avatar" />

        <!-- Text Body Skeleton 1 -->
        <View
            android:id="@+id/skeleton_text1"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintTop_toBottomOf="@id/skeleton_avatar" />

        <!-- Text Body Skeleton 2 (Shorter) -->
        <View
            android:id="@+id/skeleton_text2"
            android:layout_width="200dp"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintTop_toBottomOf="@id/skeleton_text1"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Image Attachment Skeleton -->
        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_skeleton_card"
            app:layout_constraintTop_toBottomOf="@id/skeleton_text2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>