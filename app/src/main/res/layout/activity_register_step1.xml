<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btn_register_back"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:src="@drawable/back_button_login"
        app:tint="#1e4620"
        app:layout_constraintBottom_toBottomOf="@id/layout_title_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_title_row"
        android:contentDescription="Go back" />

    <!-- Title & Logo Row (Nasa gitna ng screen) -->
    <LinearLayout
        android:id="@+id/layout_title_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_register_mini_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/smartgrow_logo"
            app:tint="#1e4620"
            android:contentDescription="SmartGrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Create Account"
            android:textColor="#1e4620"
            android:fontFamily="@font/inter_extrabold"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Step Counter -->
    <TextView
        android:id="@+id/tv_step_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="Step 1 of 5"
        android:textSize="13sp"
        android:fontFamily="@font/inter_extrabold"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_title_row" />

    <!-- Indicator Bars -->
    <LinearLayout
        android:id="@+id/layout_indicator_bars"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_step_counter">

        <View
            android:id="@+id/indicator_step1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_green" />

        <View
            android:id="@+id/indicator_step2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_gray" />

        <View
            android:id="@+id/indicator_step3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_gray" />

        <View
            android:id="@+id/indicator_step4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/indicator_gray" />

        <View
            android:id="@+id/indicator_step5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/indicator_gray" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_indicator_bars" />

    <!-- ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        app:layout_constraintBottom_toTopOf="@id/btn_register_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/tv_question_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What best describes you?"
                android:textSize="22sp"
                android:fontFamily="@font/inter_extrabold"
                android:textStyle="bold"
                android:textColor="#1e4620" />

            <TextView
                android:id="@+id/tv_question_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tell SmartGrow about your planting journey."
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/layout_choices_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_choice1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tv_choice1_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:text="Beginner plant owner"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textStyle="bold"
                        android:textColor="#1e4620" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_choice2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tv_choice2_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:text="Plant hobbyist"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textStyle="bold"
                        android:textColor="#1e4620" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_choice3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tv_choice3_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:text="Student researcher"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textStyle="bold"
                        android:textColor="#1e4620" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_choice4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tv_choice4_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:text="Home plant grower"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textStyle="bold"
                        android:textColor="#1e4620" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FIXED BOTTOM NEXT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register_next"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="Next"
        android:textSize="16sp"
        android:fontFamily="@font/inter_extrabold"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:backgroundTint="#1e4620"
        app:cornerRadius="26dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>