<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_plant_photo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_total_plants"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_plant_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="Yerba Buena"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toTopOf="@id/img_plant_photo"
            app:layout_constraintStart_toEndOf="@id/img_plant_photo"
            app:layout_constraintEnd_toStartOf="@id/tv_plant_health_percentage" />

        <TextView
            android:id="@+id/tv_plant_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Minty Fresh"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toBottomOf="@id/tv_plant_name"
            app:layout_constraintStart_toStartOf="@id/tv_plant_name"
            app:layout_constraintEnd_toStartOf="@id/tv_plant_health_percentage"/>

        <LinearLayout
            android:id="@+id/layout_schedule_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_plant_subtitle"
            app:layout_constraintStart_toStartOf="@id/tv_plant_name"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_water_drop"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_plant_next_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="Next: Tomorrow"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_plant_health_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textColor="@color/primary_green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toTopOf="@id/tv_plant_name"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/progress_plant_health"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="80"
            android:progressDrawable="@android:color/holo_green_dark"
            app:layout_constraintTop_toBottomOf="@id/layout_schedule_row"
            app:layout_constraintStart_toStartOf="@id/tv_plant_name"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>