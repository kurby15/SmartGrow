<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_card_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================= CHAT HEADER ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_chat_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- BACK BUTTON -->
            <ImageView
                android:id="@+id/ib_back_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_back"
                app:tint="@color/profile_title_color"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="Back button"/>

            <!-- NAKAGITNANG TITLE & STATUS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintTop_toTopOf="@id/ib_back_arrow"
                app:layout_constraintBottom_toBottomOf="@id/ib_back_arrow"
                app:layout_constraintStart_toEndOf="@id/ib_back_arrow"
                app:layout_constraintEnd_toStartOf="@id/ib_chat_menu">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartGrow Assistant"
                    android:textColor="@color/profile_title_color"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tv_assistant_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Your AI plant care assistant"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- MENU BUTTON -->
            <ImageView
                android:id="@+id/ib_chat_menu"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/profile_title_color"
                android:padding="2dp"
                app:layout_constraintTop_toTopOf="@id/ib_back_arrow"
                app:layout_constraintBottom_toBottomOf="@id/ib_back_arrow"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="Menu"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= RECYCLERVIEW CHAT AREA ================= -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="16dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/layout_chat_header"
            app:layout_constraintBottom_toTopOf="@id/layout_image_preview_container" />

        <!-- 📸 IMAGE PREVIEW AREA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_image_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layout_input_bar">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_preview_image"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/profile_card_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/iv_preview_selected_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Selected image preview"/>
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/ib_remove_preview_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tips_x"
                android:backgroundTint="@color/text_secondary"
                app:layout_constraintTop_toTopOf="@id/card_preview_image"
                app:layout_constraintEnd_toEndOf="@id/card_preview_image"
                android:contentDescription="Remove image"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= BOTTOM INPUT TYPE BAR ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Attach Button -->
            <ImageView
                android:id="@+id/ib_chat_attach"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Attach Media or Image Source"
                android:src="@drawable/ic_plus"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/profile_title_color" />

            <!-- Nakagitnang Text Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/app_background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ib_chat_attach"
                app:layout_constraintEnd_toStartOf="@id/ib_send_message">

                <EditText
                    android:id="@+id/et_chat_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Ask me anything about plant care..."
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/profile_title_color"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_semibold"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="13dp"
                    android:inputType="textCapSentences"
                    android:maxLines="3"
                    android:importantForAutofill="no"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Send Message Icon -->
            <ImageButton
                android:id="@+id/ib_send_message"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_send"
                android:scaleType="centerInside"
                app:tint="@color/profile_title_color"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="Send message"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>