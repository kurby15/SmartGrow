<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- ==================== MODERN FLOATING TABS ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <!-- Tab 1: My Garden (Inactive State) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tab_my_garden"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_tp"
                    app:tint="@color/text_secondary"
                    android:layout_marginEnd="8dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_tab_my_garden"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Garden"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tab 2: Snap History (Active State) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tab_snap_history"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/primary_green"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_time"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="8dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Snap History"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <!-- ==================== MODERN SEARCH SECTION ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="0dp">

                <EditText
                    android:id="@+id/et_search_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawableTint="@color/text_secondary"
                    android:drawablePadding="10dp"
                    android:hint="Search history..."
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_medium"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ==================== EXPIRATION BANNER ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_expiration_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFF9C4"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
             <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="History older than 30 days is automatically cleared."
                android:textColor="#F57F17"
                android:textSize="11sp"
                android:fontFamily="@font/inter_medium"
                android:gravity="center" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== SNAP HISTORY RECYCLERVIEW ==================== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_snap_history_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            tools:listitem="@layout/item_snap_history" />

    </LinearLayout>

</LinearLayout>