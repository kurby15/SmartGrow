<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive security and auth data from cloud backups -->
        <exclude domain="sharedpref" path="SmartGrowSecurePrefs.xml"/>
        <exclude domain="database" path="google_app_measurement_local.db"/>
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive security and auth data from device-to-device transfers -->
        <exclude domain="sharedpref" path="SmartGrowSecurePrefs.xml"/>
    </device-transfer>
</data-extraction-rules>